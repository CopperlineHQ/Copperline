[package]
name = "m68k"
version = "0.14.7"
edition = "2024"
rust-version = "1.93"
license = "MIT"
description = "A safe Rust M68000 family CPU emulator"
repository = "https://github.com/benletchford/m68k-rs"
readme = "README.md"
keywords = ["68000", "emulation", "m68k", "motorola"]
categories = ["emulators"]
publish = ["crates-io"]
exclude = [
    "/.github/**",
    "/.gitignore",
    "/.gitmodules",
    "/.release-please-manifest.json",
    "/CONTRIBUTING.md",
    "/committed.toml",
    "/release-please-config.json",
    "/rust-toolchain.toml",
    "/scripts/**",
    "/tests/**",
]

[dependencies]
serde = { version = "1.0", features = ["derive"], optional = true }

[features]
default = []
# Compile hot `run_batch` traces to native code with Cranelift. Without this
# feature, batching and FastMem remain available through the portable executor.
jit = [
    "dep:cranelift-codegen",
    "dep:cranelift-frontend",
    "dep:cranelift-jit",
    "dep:cranelift-module",
]
# Serialize the complete architectural CPU state for deterministic save states.
# Runtime-only decode, FastMem, and JIT caches are rebuilt after deserialization.
serde = ["dep:serde"]
# Opt-in trace-opportunity accounting for emulator profiling. Disabled builds
# contain none of the counters or reporting code.
trace-profile = []

[target.'cfg(not(target_family = "wasm"))'.dependencies]
cranelift-codegen = { version = "0.132.0", optional = true }
cranelift-frontend = { version = "0.132.0", optional = true }
cranelift-jit = { version = "0.132.0", optional = true }
cranelift-module = { version = "0.132.0", optional = true }

[dev-dependencies]
serde_json = "1.0"
astro-float = { version = "0.9", default-features = false, features = ["std"] }

[[bench]]
name = "microbench"
harness = false
