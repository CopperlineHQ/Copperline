{
  "name": "copperline-debug",
  "displayName": "Copperline Amiga Debug",
  "description": "Debug Amiga programs in the Copperline emulator: source-level stepping, registers, memory, chipset state and reverse execution through copperline-ctl --dap.",
  "version": "0.2.0",
  "publisher": "copperline",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/CopperlineHQ/Copperline"
  },
  "homepage": "https://copperline.dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Extension Packs"
  ],
  "keywords": [
    "amiga",
    "68000",
    "m68k",
    "emulator",
    "debugger"
  ],
  "main": "./extension.js",
  "extensionPack": [
    "prb28.amiga-assembly"
  ],
  "activationEvents": [
    "onDebugResolve:copperline",
    "onCommand:copperline.profile",
    "onCommand:copperline.profileMulti",
    "onCommand:copperline.showDebugger",
    "onCommand:copperline.showConsole",
    "onCommand:copperline.showAnalyzer",
    "onCommand:copperline.initProject",
    "onCommand:copperline.exe2adf",
    "onCommand:copperline.sizeReport",
    "onView:copperline.customRegisters"
  ],
  "contributes": {
    "configuration": {
      "title": "Copperline",
      "properties": {
        "copperline.ctlExecutable": {
          "type": "string",
          "default": "copperline-ctl",
          "description": "Path to the copperline-ctl executable file (not its directory); it serves the debug adapter as copperline-ctl --dap. A bare name is looked up on PATH."
        },
        "copperline.emulatorExecutable": {
          "type": "string",
          "default": "",
          "description": "Path to the copperline executable file (not its directory) that a launch starts. Empty: the copperline next to copperline-ctl, else PATH. A launch configuration's \"copperline\" attribute overrides this."
        }
      }
    },
    "breakpoints": [
      { "language": "c" },
      { "language": "cpp" },
      { "language": "m68k" },
      { "language": "asm" },
      { "language": "amiga-assembly" },
      { "language": "vasm" }
    ],
    "commands": [
      {
        "command": "copperline.profile",
        "title": "Copperline: Profile",
        "icon": "$(graph)"
      },
      {
        "command": "copperline.profileMulti",
        "title": "Copperline: Profile (Multi)",
        "icon": "$(pulse)"
      },
      {
        "command": "copperline.showDebugger",
        "title": "Copperline: Open Debugger Window",
        "icon": "$(debug-alt)"
      },
      {
        "command": "copperline.showConsole",
        "title": "Copperline: Open Console Window",
        "icon": "$(terminal)"
      },
      {
        "command": "copperline.showAnalyzer",
        "title": "Copperline: Open Frame Analyzer",
        "icon": "$(inspect)"
      },
      {
        "command": "copperline.refreshCustomRegisters",
        "title": "Copperline: Refresh Custom Registers",
        "icon": "$(refresh)"
      },
      {
        "command": "copperline.initProject",
        "title": "Copperline: Init Amiga Project"
      },
      {
        "command": "copperline.exe2adf",
        "title": "Copperline: Convert EXE to ADF"
      },
      {
        "command": "copperline.sizeReport",
        "title": "Copperline: Profile File Size"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "copperline.customRegisters",
          "name": "Custom Registers",
          "when": "debugType == copperline"
        }
      ]
    },
    "menus": {
      "debug/toolBar": [
        {
          "command": "copperline.showDebugger",
          "when": "debugType == copperline",
          "group": "navigation@40"
        },
        {
          "command": "copperline.showConsole",
          "when": "debugType == copperline",
          "group": "navigation@41"
        },
        {
          "command": "copperline.showAnalyzer",
          "when": "debugType == copperline",
          "group": "navigation@42"
        },
        {
          "command": "copperline.profile",
          "when": "debugType == copperline",
          "group": "navigation@50"
        },
        {
          "command": "copperline.profileMulti",
          "when": "debugType == copperline",
          "group": "navigation@51"
        }
      ],
      "view/title": [
        {
          "command": "copperline.refreshCustomRegisters",
          "when": "view == copperline.customRegisters",
          "group": "navigation"
        }
      ]
    },
    "debuggers": [
      {
        "type": "copperline",
        "label": "Copperline (Amiga)",
        "languages": [
          "c",
          "cpp",
          "m68k",
          "asm"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Amiga executable (hunk file) to run, on the host. Its directory is mounted in the guest and it is started from the shell.",
                "default": "${workspaceFolder}/${fileBasenameNoExtension}"
              },
              "args": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "Command-line arguments for the program.",
                "default": []
              },
              "copperline": {
                "type": "string",
                "description": "The copperline executable file to start (default: the copperline.emulatorExecutable setting, then the copperline next to copperline-ctl, then PATH)."
              },
              "config": {
                "type": "string",
                "description": "A Copperline TOML configuration file for the machine (default: the launcher's saved default configuration)."
              },
              "rom": {
                "type": "string",
                "description": "A Kickstart ROM path supplied positionally to Copperline. The bundled AROS ROM is used when omitted."
              },
              "factory": {
                "type": "boolean",
                "description": "Ignore the saved default configuration (copperline --factory).",
                "default": false
              },
              "model": {
                "type": "string",
                "description": "Machine model (A500, A600, A1200, A4000, CD32...)."
              },
              "chipset": {
                "type": "string",
                "description": "OCS, ECS or AGA."
              },
              "cpu": {
                "type": "string",
                "description": "68000 to 68060."
              },
              "chip": {
                "type": "string",
                "description": "Chip RAM size (512K, 1M, 2M)."
              },
              "fast": {
                "type": "string",
                "description": "Fast RAM size (8M, 32M...)."
              },
              "slow": {
                "type": "string",
                "description": "Slow RAM size."
              },
              "memoryFill": {
                "type": "string",
                "description": "Cold-start RAM contents: zero, random[:SEED], pattern:WORD, or 0xWORD (copperline --ram-init)."
              },
              "fpu": {
                "type": "boolean",
                "description": "Fit or omit an FPU (copperline --fpu / --no-fpu)."
              },
              "stack": {
                "type": "integer",
                "minimum": 4,
                "description": "Set the AmigaDOS CLI stack before launching the program."
              },
              "ntsc": {
                "type": "boolean",
                "description": "Use NTSC video timing when true, PAL when false."
              },
              "detach": {
                "type": "boolean",
                "description": "Launch the guest program asynchronously and close the boot CLI."
              },
              "emulatorLog": {
                "type": "boolean",
                "description": "Mirror the launched emulator log into the Debug Console.",
                "default": false
              },
              "rtcTime": {
                "type": "string",
                "description": "Seed the guest clock (copperline --rtc-time), for reproducible runs."
              },
              "extraArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Further copperline command-line arguments.",
                "default": []
              },
              "headless": {
                "type": "boolean",
                "description": "Run without a window (copperline --control instead of --control-gui). The screen is then only reachable through the control protocol.",
                "default": false
              },
              "noAudio": {
                "type": "boolean",
                "description": "Start the window without audio.",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's entry point once it is loaded.",
                "default": true
              },
              "entryPoint": {
                "type": "string",
                "description": "The symbol to treat as the entry point (default: the first instruction of the first hunk). \"main\" or \"entry\" for C programs with a startup stub."
              },
              "symbolFile": {
                "type": "string",
                "description": "An ELF with DWARF the program was converted from (elf2hunk); \"program.elf\" is tried automatically."
              },
              "sourceMap": {
                "type": "object",
                "description": "Source path prefixes recorded in the debug information mapped to host paths, {\"/build/dir\": \"${workspaceFolder}\"}.",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the emulator process."
              },
              "timeoutMs": {
                "type": "number",
                "description": "How long to wait for the emulator to announce its control endpoint.",
                "default": 60000
              }
            }
          },
          "attach": {
            "properties": {
              "controlInfo": {
                "type": "string",
                "description": "The JSON file a running copperline wrote with --control-info."
              },
              "address": {
                "type": "string",
                "description": "The control server address (with token) when no info file is at hand."
              },
              "token": {
                "type": "string",
                "description": "The control server token (with address)."
              },
              "program": {
                "type": "string",
                "description": "The executable the guest is running or about to run, for its symbols and source lines."
              },
              "symbolFile": {
                "type": "string",
                "description": "An ELF with DWARF the program was converted from."
              },
              "sourceMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "entryPoint": {
                "type": "string"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "When the program is not loaded yet, stop at its entry point once it is.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "copperline",
            "request": "launch",
            "name": "Run in Copperline",
            "program": "${workspaceFolder}/${fileBasenameNoExtension}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Copperline: launch a program",
            "description": "Start Copperline, boot to the program and stop at its entry point",
            "body": {
              "type": "copperline",
              "request": "launch",
              "name": "Run ${1:hello} in Copperline",
              "program": "^\"\\${workspaceFolder}/${1:hello}\"",
              "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A500 KS1.3 512K+512K",
            "description": "A500, 68000, 512K chip + 512K slow RAM, with a Kickstart 1.3 ROM",
            "body": {
              "type": "copperline", "request": "launch", "name": "A500 KS1.3 512K+512K",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "rom": "${2:/path/to/kick13.rom}", "model": "A500", "cpu": "68000",
              "chip": "512K", "slow": "512K", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A1200",
            "description": "Stock A1200 preset",
            "body": {
              "type": "copperline", "request": "launch", "name": "A1200",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "model": "A1200", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A1200-FAST",
            "description": "A1200 with 8 MiB fast RAM",
            "body": {
              "type": "copperline", "request": "launch", "name": "A1200-FAST",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "model": "A1200", "fast": "8M", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A1200-030",
            "description": "A1200 with a 68030 and 8 MiB fast RAM",
            "body": {
              "type": "copperline", "request": "launch", "name": "A1200-030",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "model": "A1200", "cpu": "68030", "fast": "8M", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A3000",
            "description": "Stock A3000 preset",
            "body": {
              "type": "copperline", "request": "launch", "name": "A3000",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "model": "A3000", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: A4000",
            "description": "Stock A4000 preset",
            "body": {
              "type": "copperline", "request": "launch", "name": "A4000",
              "program": "^\"\\${workspaceFolder}/${1:demo}\"", "symbolFile": "^\"\\${workspaceFolder}/${1:demo}.elf\"",
              "model": "A4000", "entryPoint": "main", "stopOnEntry": true
            }
          },
          {
            "label": "Copperline: attach to a running emulator",
            "description": "Attach to copperline --control-gui ... --control-info FILE",
            "body": {
              "type": "copperline",
              "request": "attach",
              "name": "Attach to Copperline",
              "controlInfo": "${1:/tmp/ccp.json}",
              "program": "^\"\\${workspaceFolder}/${2:hello}\""
            }
          }
        ]
      }
    ]
  }
}
