# Builds chftest (M2), chftest_m4 (M4), and chftest_m6 (M6), the guest-side
# probes for copperhf.device (tests/copperhf_device.rs,
# tests/copperhf_m4_guest.rs, tests/copperhf_m6.rs), with the
# dockerized m68k-amigaos cross-GCC (see ../toolchain.mk). Normal relocatable
# hunk executables with the standard -noixemul startup, the same style
# guest/modem-test and guest/zz9kprobe use and verified against both AROS and
# Kickstart 3.1 -- chftest/chftest_m4 only call exec.library (none of
# zz9kprobe's -fcommon DOSBase-merge concern); chftest_m6 also calls
# dos.library (LockDosList/NextDosEntry), same #include <proto/dos.h>
# auto-open idiom as guest/modem-test/modemtest.c.
#
# lsegfix -- the M6 LSEG-chain stress fixture chftest_m6 loads indirectly
# through the mounter's FSHD/LSEG path -- is NOT built by this Makefile: it
# is a hand-crafted raw HUNK file generated by gen_lsegfix.py (plain
# python3, no docker/cross-toolchain involved; see that script's own header
# comment for why). Both the generator and its committed output
# (guest/copperhf-test/lsegfix) live in this directory; regenerate with
# `python3 gen_lsegfix.py lsegfix` and commit the result if it ever changes.

include ../toolchain.mk

CFLAGS  = -Os -m68000 -fomit-frame-pointer -Wall -Wextra -noixemul

all: chftest chftest_m4 chftest_m6

chftest: chftest.c
	$(CC) $(CFLAGS) -s chftest.c -o $@

chftest_m4: chftest_m4.c
	$(CC) $(CFLAGS) -s chftest_m4.c -o $@

chftest_m6: chftest_m6.c
	$(CC) $(CFLAGS) -s chftest_m6.c -o $@

lsegfix: gen_lsegfix.py
	python3 gen_lsegfix.py $@

clean:
	rm -f chftest chftest_m4 chftest_m6

.PHONY: clean all
