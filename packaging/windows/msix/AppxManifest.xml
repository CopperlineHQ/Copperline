<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest template for the Microsoft Store build of Copperline.
  build-msix.ps1 substitutes the @TOKEN@ placeholders and writes one copy of
  this per architecture; the identity values come from identity.psd1 and must
  match Partner Center exactly.

  Copperline is an ordinary Win32 program, not a UWP app: EntryPoint
  "Windows.FullTrustApplication" plus the runFullTrust capability is what
  packages a desktop binary as MSIX, and it runs with the user's own token,
  with no filesystem or networking restrictions beyond a normal program's.
  runFullTrust is a restricted capability in name only here; the Store grants
  it to packaged desktop applications as a matter of course.

  No file type associations are declared. The emulator parses a bare command
  line path as a Kickstart ROM (src/cli.rs), so associating .adf and friends
  would make a double-clicked disk image fail rather than boot. Declare them
  once a positional path is dispatched by what the file actually is.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCHITECTURE@" />

  <Properties>
    <DisplayName>Copperline</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A cycle-driven Commodore Amiga emulator: OCS, ECS and AGA, from the A1000 to the A4000, CDTV and CD32.</Description>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 (Windows 10 1809) is the floor for the MSIX features used
         here; MaxVersionTested names the newest Windows this build has been
         run against. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Copperline" Executable="copperline.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Copperline"
        Description="A cycle-driven Commodore Amiga emulator: OCS, ECS and AGA, from the A1000 to the A4000, CDTV and CD32."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <!--
        An execution alias, so an installed package still answers to
        "copperline" at a prompt: a packaged app installs under
        WindowsApps, which is not a directory anybody puts on PATH by hand.
      -->
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="copperline.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="copperline.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <!--
      copperline-ctl and copperline-import-uae ship inside the package but
      are deliberately not aliased. An Application may declare
      windows.appExecutionAlias only once, so aliasing them needs an
      Application element each, and hiding those with AppListEntry="none"
      is what the Store calls a headless app, which needs a
      "HeadlessAppBypass" waiver:

        Package acceptance validation error: The package file
        Copperline-x64.msix specifies a headless app. You don't have
        permission to create a headless app.

      Listing them visibly instead would put two console tools in the Start
      menu, where clicking one flashes a window and exits. Neither is worth
      it: the portable zip remains the way to get the command-line tooling.
    -->
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
